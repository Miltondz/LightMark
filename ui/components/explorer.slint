import { Button, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { IconButton } from "icon_button.slint";

export struct ExplorerEntry {
    name: string,
    is_dir: bool,
    path: string,
}

export component Explorer inherits Rectangle {
    in property <string> current-folder: "";
    // V24: la cabecera solo debe mostrar el nombre de la carpeta (no la ruta completa,
    // que la desbordaba); la ruta completa se muestra en un Tooltip al pasar el mouse.
    in property <string> current-folder-path: "";
    in property <[ExplorerEntry]> entries;
    in property <bool> has-folder: false;

    callback open-folder();
    callback navigate-parent();
    callback navigate(string);
    callback open-entry(string);

    width: 210px;
    background: Theme.sidebar-bg;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Cabecera
        Rectangle {
            height: 26px;

            if root.current-folder-path != "": Tooltip {
                text: @markdown("\{root.current-folder-path}");
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 4px;
                spacing: 2px;
                header-label := Text {
                    text: root.current-folder != "" ? "EXPLORADOR  ·  " + root.current-folder : "EXPLORADOR";
                    font-size: Theme.font-size-small;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                IconButton {
                    icon: @image-url("../icons/arrow-up.svg");
                    tooltip-text: "Carpeta superior";
                    enabled: root.has-folder;
                    width: 22px;
                    height: 22px;
                    clicked => { root.navigate-parent(); }
                }
                IconButton {
                    icon: @image-url("../icons/folder-open.svg");
                    tooltip-text: "Abrir carpeta…";
                    width: 22px;
                    height: 22px;
                    clicked => { root.open-folder(); }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        if !root.has-folder: VerticalLayout {
            alignment: center;
            padding: 16px;
            spacing: 10px;
            Text {
                text: "Ninguna carpeta abierta";
                font-size: Theme.font-size-normal;
                color: Theme.text-muted;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Button {
                text: "Abrir carpeta…";
                clicked => { root.open-folder(); }
            }
        }

        if root.has-folder: ScrollView {
            vertical-stretch: 1;

            entries-col := VerticalLayout {
                padding: 0px;
                spacing: 0px;
                alignment: start;

                for entry in root.entries: Rectangle {
                    height: 22px;
                    background: entry-ta.has-hover ? Theme.hover : transparent;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;

                        Image {
                            source: entry.is_dir ? @image-url("../icons/folder.svg") : @image-url("../icons/file.svg");
                            width: 14px;
                            height: 14px;
                            colorize: Theme.icon-color;
                        }

                        Text {
                            text: entry.name;
                            font-size: Theme.font-size-normal;
                            color: Theme.text;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }

                    entry-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if entry.is_dir {
                                root.navigate(entry.path);
                            } else {
                                root.open-entry(entry.path);
                            }
                        }
                    }

                    Tooltip {
                        text: @markdown("\{entry.path}");
                    }
                }
            }
        }
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: Theme.border;
    }
}
